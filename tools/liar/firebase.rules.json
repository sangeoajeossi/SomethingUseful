{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{4}$/)",
        ".write": "$code.matches(/^[A-Z0-9]{4}$/) && (!newData.exists() || (newData.child('createdAt').isNumber() && newData.child('createdAt').val() <= now + 60000 && newData.child('createdAt').val() > now - 43200000))",
        "hostId": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "phase": { ".validate": "newData.isString() && newData.val().matches(/^(lobby|play|vote|result|end)$/)" },
        "settings": {
          "liars": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "cats": { "$i": { ".validate": "newData.isString() && newData.val().length <= 16" } },
          "revealLiar": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "players": {
          "$pid": {
            ".validate": "$pid.length <= 32",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
            "order": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "round": {
          "n": { ".validate": "newData.isNumber()" },
          "v": { ".validate": "newData.isNumber()" },
          "catName": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "first": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "timerEnd": { ".validate": "newData.isNumber()" },
          "winner": { ".validate": "newData.isString() && newData.val().matches(/^(citizen|liar)$/)" },
          "words": {
            "$side": {
              ".validate": "$side.matches(/^(citizen|liar)$/)",
              "ko": { ".validate": "newData.isString() && newData.val().length <= 32" },
              "en": { ".validate": "newData.isString() && newData.val().length <= 48" },
              "$other": { ".validate": false }
            }
          },
          "roles": { "$pid": { ".validate": "$pid.length <= 32 && newData.isString() && newData.val().matches(/^(citizen|liar)$/)" } },
          "alive": { "$pid": { ".validate": "$pid.length <= 32 && newData.isBoolean()" } },
          "votes": { "$pid": { ".validate": "$pid.length <= 32 && newData.isString() && newData.val().length <= 32" } },
          "last": {
            "out": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "tie": { ".validate": "newData.isBoolean()" },
            "role": { ".validate": "newData.isString() && newData.val().matches(/^(citizen|liar)$/)" },
            "count": { "$pid": { ".validate": "$pid.length <= 32 && newData.isNumber()" } },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
